{
  "name": "@deepseek-ai/dsh-tool-memory",
  "description": "Model-facing memory_save tool plus per-turn memory injection over a human-editable memory file",
  "version": "0.1.0-rc.7",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttmouse/dsh-muse.git",
    "directory": "tool-memory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./storage": { "types": "./lib/types/storage.d.ts", "default": "./lib/storage.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/*.js", "lib/types/**/*.d.ts", "cordis.patch.yml"],
  "license": "MIT",
  "scripts": { "build": "tsc -b && tsdown", "test": "vitest run" },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "tsdown": "^0.14",
    "typescript": "^5.9",
    "vitest": "^3"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
