{
  "name": "dsh-muse",
  "version": "0.1.0-rc.7",
  "private": true,
  "description": "Muse autonomy keeper family for DeepSeek Harness: durable autonomy intent plus standing goal re-arming",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttmouse/dsh-muse.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "autonomy",
    "goal",
    "agent"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm --filter @deepseek-ai/dsh-muse exec tsdown && pnpm --filter @deepseek-ai/dsh-tool-muse exec tsdown && pnpm --filter @deepseek-ai/dsh-tool-memory exec tsdown",
    "test": "vitest run",
    "test:timers": "node --test examples/tests/*.test.mjs",
    "test:evolution": "node --test scripts/evolution.test.mjs",
    "evolution:status": "node scripts/evolution.mjs status",
    "evolution:check": "node scripts/evolution.mjs check",
    "evolution:report": "node scripts/evolution.mjs report"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsdown": "^0.14",
    "typescript": "^5.9",
    "vitest": "^3"
  }
}
